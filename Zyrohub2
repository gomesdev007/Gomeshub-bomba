autoSkipToggle:OnChanged(function()
    task.spawn(function()
        while Options.AutoSkipWave.Value do
            local skipEvent = ReplicatedStorage:FindFirstChild("Modules")
                and ReplicatedStorage.Modules:FindFirstChild("GlobalInit")
                and ReplicatedStorage.Modules.GlobalInit:FindFirstChild("RemoteEvents")
                and ReplicatedStorage.Modules.GlobalInit.RemoteEvents:FindFirstChild("PlayerReadyForNextWave")

            if skipEvent then
                skipEvent:FireServer()
            end

            task.wait(1)
        end
    end)
end)

