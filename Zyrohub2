Tabs.AutoPlace:AddParagraph({
    Title = "Automated Unit Deployment",
    Content = "Executes sequential unit placement using predefined coordinates and fixed delays."
})

local TowerPositions = {
    [1] = Vector3.new(-231.43, 0.39, -317.83),
    [2] = Vector3.new(-240.01, 0.34, -322.49),
    [3] = Vector3.new(-237.41, -2.03, -303.31),
    [4] = Vector3.new(-247.93, -2.08, -312.26),
    [5] = Vector3.new(-262.38, -1.58, -324.84),
}

local function getPlayerMoney()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local money = leaderstats:FindFirstChild("Money") 
            or leaderstats:FindFirstChild("Coins") 
            or leaderstats:FindFirstChild("Cash")
            or leaderstats:FindFirstChild("Gems")
        if money then return money.Value end
    end
    return nil
end

local isPlacing = false

Tabs.AutoPlace:AddButton({
    Title = "Start Automated Unit Placement",
    Description = "Deploys 5 units sequentially with 2-second intervals between each",
    Callback = function()
        if isPlacing then return end
        isPlacing = true

        task.spawn(function()
            local placeEvent = ReplicatedStorage:FindFirstChild("GenericModules")
                and ReplicatedStorage.GenericModules:FindFirstChild("Service")
                and ReplicatedStorage.GenericModules.Service:FindFirstChild("Network")
                and ReplicatedStorage.GenericModules.Service.Network:FindFirstChild("PlayerPlaceTower")

            if placeEvent then
                local unitID = "5409636515:14"
                local fixedDelay = 2
                local maxRetries = 3

                for index, pos in ipairs(TowerPositions) do
                    local initialMoney = getPlayerMoney()
                    local placedSuccess = false

                    for attempt = 1, maxRetries do
                        placeEvent:FireServer(unitID, pos, 0)

                        task.wait(fixedDelay)

                        local currentMoney = getPlayerMoney()
                        if initialMoney and currentMoney then
                            if currentMoney <= 0 then
                                isPlacing = false
                                return
                            end
                        end

                        placedSuccess = true
                        break
                    end
                end
            end

            isPlacing = false
        end)
    end
})

