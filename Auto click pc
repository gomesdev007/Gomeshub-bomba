local function IsMouseOverOurGui()

    local mousePosition = UserInputService:GetMouseLocation()

    local absolutePosition = MainFrame.AbsolutePosition
    local absoluteSize = MainFrame.AbsoluteSize

    local insideX =
        mousePosition.X >= absolutePosition.X
        and mousePosition.X <= absolutePosition.X + absoluteSize.X

    local insideY =
        mousePosition.Y >= absolutePosition.Y
        and mousePosition.Y <= absolutePosition.Y + absoluteSize.Y

    return insideX and insideY
end



