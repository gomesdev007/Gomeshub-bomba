-- Sistema de Rotação por Toque sem Conflito de Multi-Touch
UserInputService.InputBegan:Connect(function(input, processed)
    if not camActive or camLocked or processed then return end
    if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton2) and not dragInputObject then
        dragInputObject = input
        lastPos = Vector2.new(input.Position.X, input.Position.Y)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not camActive or camLocked or input ~= dragInputObject then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
        local currPos = Vector2.new(input.Position.X, input.Position.Y)
        local delta = currPos - lastPos
        lastPos = currPos

        camYaw = camYaw - (delta.X * 0.0035)
        camPitch = math.clamp(camPitch - (delta.Y * 0.0035), math.rad(-89), math.rad(89))
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == dragInputObject then
        dragInputObject = nil
    end
end)

-- Loop principal da Câmera (Posição calculada separadamente)
RunService.RenderStepped:Connect(function(dt)
    if not camActive then return end

    local rotCFrame = CFrame.Angles(0, camYaw, 0) * CFrame.Angles(camPitch, 0, 0)

    if camLocked then
        Camera.CFrame = CFrame.new(camPos) * rotCFrame
        return
    end

    local moveVec = Vector3.zero
    if Controls and Controls.GetMoveVector then
        moveVec = Controls:GetMoveVector()
    end

    local moveDirection = (rotCFrame.RightVector * moveVec.X) + (rotCFrame.LookVector * -moveVec.Z)

    camPos = camPos + (moveDirection * (50 * speedMultiplier * dt))
    Camera.CFrame = CFrame.new(camPos) * rotCFrame
end)

-- Toggle Câmera
ToggleBtn.MouseButton1Click:Connect(function()
    camActive = not camActive

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if camActive then
        ToggleBtn.Text = "Câmera Livre: ON"
        ToggleBtn.TextColor3 = Color3.fromRGB(80, 220, 120)

        camPos = Camera.CFrame.Position
        local rx, ry, rz = Camera.CFrame:ToOrientation()
        camYaw = ry
        camPitch = rx

        Camera.CameraType = Enum.CameraType.Scriptable

        if hum then
            hum.WalkSpeed = 0
        end
    else
        ToggleBtn.Text = "Câmera Livre: OFF"
        ToggleBtn.TextColor3 = Color3.fromRGB(220, 70, 70)

        camLocked = false
        LockBtn.Text = "Travar Câmera: OFF"
        LockBtn.TextColor3 = Color3.fromRGB(200, 200, 200)

        dragInputObject = nil

        Camera.CameraType = Enum.CameraType.Custom
        if hum then
            hum.WalkSpeed = 16
            Camera.CameraSubject = hum
        end
    end
end)

